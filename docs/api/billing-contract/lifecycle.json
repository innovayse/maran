        "path": "/accounts/{{foreignAccountId}}/plan",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-plan-foreign-account"
        },
        "body": {
          "planId": "{{planId}}"
        }
      },
      "response": {
        "status": 404,
        "code": "AccountNotFound"
      }
    },
    {
      "name": "change-plan-without-an-idempotency-key",
      "request": {
        "method": "PUT",
        "path": "/accounts/{{accountId}}/plan",
        "body": {
          "planId": "{{planId}}"
        }
      },
      "response": {
        "status": 400,
        "code": "IdempotencyKeyRequired"
      }
    },
    {
      "name": "server-info-after-the-changes",
      "request": {
        "method": "GET",
        "path": "/info"
      },
      "response": {
        "status": 200,
        "properties": [
          {
            "name": "apiRevision",
            "type": "integer"
          },
          {
            "name": "accountCount",
            "type": "integer"
          },
          {
            "name": "planCount",
            "type": "integer"
          },
          {
            "name": "diskAllocatedMb",
            "type": "integer"
          },
          {
            "name": "envelope",
            "type": "object"
          },
          {
            "name": "envelope.maxAccounts",
            "type": "integer"
          },
          {
            "name": "envelope.diskPoolMb",
            "type": "integer"
          }
        ]
      }
    },
    {
      "name": "create-account-with-a-read-only-key",
      "credential": "reader",
      "request": {
        "method": "POST",
        "path": "/accounts",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-reader-create"
        },
        "body": {
          "name": "bh{{suffix}}",
          "primaryDomain": "bh{{suffix}}.example.com",
          "planId": "{{planId}}",
          "ownerEmail": "owner-{{suffix}}@example.com",
          "ownerLanguage": "en"
        }
      },
      "response": {
        "status": 403
      }
    },
    {
      "name": "terminate-account-without-the-delete-scope",
      "credential": "provisioner",
      "request": {
        "method": "DELETE",
        "path": "/accounts/{{accountId}}",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-provisioner-terminate"
        }
      },
      "response": {
        "status": 403
      }
    },
    {
      "name": "read-account-with-an-unknown-key",
      "credential": "unknown",
      "request": {
        "method": "GET",
        "path": "/accounts/{{accountId}}"
      },
      "response": {
        "status": 401,
        "empty": true
      }
    },
    {
      "name": "read-account-with-no-key",
      "credential": "none",
      "request": {
        "method": "GET",
        "path": "/accounts/{{accountId}}"
      },
      "response": {
        "status": 401,
        "empty": true
      }
    },
    {
      "name": "terminate-account-without-an-idempotency-key",
      "request": {
        "method": "DELETE",
        "path": "/accounts/{{accountId}}"
      },
      "response": {
        "status": 400,
        "code": "IdempotencyKeyRequired"
      }
    },
    {
      "name": "terminate-an-account-of-another-reseller",
      "requires": [
        "foreignAccountId"
      ],
      "request": {
        "method": "DELETE",
        "path": "/accounts/{{foreignAccountId}}",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-terminate-foreign"
        }
      },
      "response": {
        "status": 404,
        "code": "AccountNotFound"
      }
    },
    {
      "name": "terminate-account-when-the-final-backup-fails",
      "note": "The deletion is refused and the account stays as it was. The answer is a server error, not a conflict; a server error is not stored, so the same Idempotency-Key may be sent again.",
      "arrange": "finalBackupFails",
      "request": {
        "method": "DELETE",
        "path": "/accounts/{{accountId}}",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-terminate-backup"
        }
      },
      "response": {
        "status": 500,
        "code": "FinalBackupFailed"
      }
    },
    {
      "name": "read-account-after-the-refused-termination",
      "request": {
        "method": "GET",
        "path": "/accounts/{{accountId}}"
      },
      "response": {
        "status": 200,
        "properties": [
          {
            "name": "id",
            "type": "guid",
            "equalsVariable": "accountId"
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "primaryDomain",
            "type": "string"
          },
          {
            "name": "planId",
            "type": "guid"
          },
          {
            "name": "status",
            "type": "string",
            "equals": "active"
          },
          {
            "name": "statusName",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "instant"
          },
          {
            "name": "resellerId",
            "type": "guid"
          },
          {
            "name": "resellerName",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "terminate-account",
      "request": {
        "method": "DELETE",
        "path": "/accounts/{{accountId}}",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-terminate"
        }
      },
      "response": {
        "status": 200,
        "properties": [
          {
            "name": "$",
            "type": "integer"
          }
        ]
      }
    },
    {
      "name": "terminate-account-replayed-with-the-same-key",
      "request": {
        "method": "DELETE",
        "path": "/accounts/{{accountId}}",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-terminate"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Idempotent-Replayed": "true"
        },
        "properties": [
          {
            "name": "$",
            "type": "integer"
          }
        ]
      }
    },
    {
      "name": "read-account-after-termination",
      "request": {
        "method": "GET",
        "path": "/accounts/{{accountId}}"
      },
      "response": {
        "status": 404,
        "code": "AccountNotFound"
      }
    },
    {
      "name": "terminate-account-again",
      "request": {
        "method": "DELETE",
        "path": "/accounts/{{accountId}}",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-terminate-again"
        }
      },
      "response": {
        "status": 404,
        "code": "AccountNotFound"
      }
    }
  ]
}
