{
  "contract": "maran-billing-lifecycle",
  "revision": 1,
  "description": "The sequence a billing provider relies on when it provisions hosting accounts through the reseller API of a Maran panel. Read docs/api/billing-contract/README.md before editing.",
  "basePath": "/api/v1/reseller-api",
  "inputs": {
    "planId": "required: a plan the reseller owns, with room in the reseller's disk pool for one more account",
    "smallPlanId": "optional: a second plan of the reseller with less disk than planId",
    "largePlanId": "optional: a plan of the reseller whose disk would take the reseller over its disk pool when the account moves to it",
    "fullPoolPlanId": "optional: a plan of the reseller that no longer fits the reseller's disk pool when a new account is created on it",
    "foreignPlanId": "optional: the id of a plan another reseller owns",
    "foreignAccountId": "optional: the id of an account another reseller owns"
  },
  "credentials": {
    "full": "required: a key of the reseller holding accounts.read, accounts.write and accounts.delete",
    "provisioner": "optional: a key of the reseller holding accounts.read and accounts.write only",
    "reader": "optional: a key of the reseller holding accounts.read only",
    "unknown": "built in: a well-formed key the panel has never issued",
    "none": "built in: no key header at all"
  },
  "arrangements": {
    "diskUsedAbovePlan": "the host measures more disk used by the account than the plan named in the interaction allows",
    "finalBackupFails": "the final backup that terminating an account takes first fails"
  },
  "builtins": {
    "run": "a fresh identifier per replay, so Idempotency-Key values never collide between replays",
    "suffix": "eight lower-case hexadecimal characters, fresh per replay, so account names and domains never collide",
    "randomGuid": "a GUID that names nothing"
  },
  "interactions": [
    {
      "name": "server-info",
      "request": {
        "method": "GET",
        "path": "/info"
      },
      "response": {
        "status": 200,
        "properties": [
          {
            "name": "apiRevision",
            "type": "integer"
          },
          {
            "name": "accountCount",
            "type": "integer"
          },
          {
            "name": "planCount",
            "type": "integer"
          },
          {
            "name": "diskAllocatedMb",
            "type": "integer"
          },
          {
            "name": "envelope",
            "type": "object"
          },
          {
            "name": "envelope.maxAccounts",
            "type": "integer"
          },
          {
            "name": "envelope.diskPoolMb",
            "type": "integer"
          }
        ]
      }
    },
    {
      "name": "create-account",
      "request": {
        "method": "POST",
        "path": "/accounts",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-create"
        },
        "body": {
          "name": "bc{{suffix}}",
          "primaryDomain": "bc{{suffix}}.example.com",
          "planId": "{{planId}}",
          "ownerEmail": "owner-{{suffix}}@example.com",
          "ownerLanguage": "en"
        }
      },
      "response": {
        "status": 201,
        "properties": [
          {
            "name": "id",
            "type": "guid"
          },
          {
            "name": "name",
            "type": "string",
            "equals": "bc{{suffix}}"
          },
          {
            "name": "primaryDomain",
            "type": "string"
          },
          {
            "name": "planId",
            "type": "guid",
            "equalsVariable": "planId"
          },
          {
            "name": "status",
            "type": "string",
            "equals": "active"
          },
          {
            "name": "statusName",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "instant"
          },
          {
            "name": "resellerId",
            "type": "guid"
          },
          {
            "name": "resellerName",
            "type": "string"
          }
        ],
        "absent": [
          "ownerEmail"
        ],
        "capture": {
          "accountId": "id"
        }
      }
    },
    {
      "name": "create-account-replayed-with-the-same-key",
      "request": {
        "method": "POST",
        "path": "/accounts",
        "headers": {
          "Idempotency-Key": "bc-{{run}}-create"
        },
        "body": {
          "name": "bc{{suffix}}",
          "primaryDomain": "bc{{suffix}}.example.com",
          "planId": "{{planId}}",
          "ownerEmail": "owner-{{suffix}}@example.com",
          "ownerLanguage": "en"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Idempotent-Replayed": "true"
        },
        "properties": [
          {
            "name": "id",
            "type": "guid",
            "equalsVariable": "accountId"
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "primaryDomain",
            "type": "string"
          },
          {
            "name": "planId",
            "type": "guid",
            "equalsVariable": "planId"
          },
          {
            "name": "status",
            "type": "string",
            "equals": "active"
          },
          {
            "name": "statusName",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "instant"
          },
          {
            "name": "resellerId",
            "type": "guid"
          },
          {
            "name": "resellerName",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "create-account-with-a-key-already-used-for-another-body",
      "request": {
        "method": "POST",
        "path": "/accounts",
        "headers": {
