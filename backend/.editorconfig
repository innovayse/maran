# Backend-specific C# style, analyzer and naming rules.
# Inherits repository-wide formatting from the root .editorconfig (no `root = true` here).

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
max_line_length = 120

# Language conventions
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming rules

# Interfaces must be IPascalCase
dotnet_naming_rule.interfaces_should_be_ipascalcase.severity = warning
dotnet_naming_rule.interfaces_should_be_ipascalcase.symbols = interface_symbol
dotnet_naming_rule.interfaces_should_be_ipascalcase.style = ipascalcase_style

dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_symbols.interface_symbol.applicable_accessibilities = *

dotnet_naming_style.ipascalcase_style.required_prefix = I
dotnet_naming_style.ipascalcase_style.capitalization = pascal_case

# Constants, properties, methods must be PascalCase.
# Declared BEFORE the private-fields rule below: naming rules are evaluated in
# declaration order with first-match-wins, and this symbol group's
# required_modifiers = const makes it match private const fields too (accessibility
# list includes "private"), so a private const resolves to PascalCase instead of
# falling through to the private-field _camelCase rule.
dotnet_naming_rule.members_should_be_pascalcase.severity = warning
dotnet_naming_rule.members_should_be_pascalcase.symbols = member_symbol
dotnet_naming_rule.members_should_be_pascalcase.style = pascalcase_style

dotnet_naming_symbols.member_symbol.applicable_kinds = property, method, field
dotnet_naming_symbols.member_symbol.applicable_accessibilities = public, internal, protected, protected_internal, private_protected, private
dotnet_naming_symbols.member_symbol.required_modifiers = const

# `static readonly` fields are PascalCase, for the same reason and by the same mechanism as the
# const rule above: a cached delegate, a fixed array of method names, a probe timeout — they are
# constants that the language will not let us declare `const`, they never change after type
# initialisation, and rules/csharp.md groups them WITH the constants in its member order, not with
# the instance fields. Declared before the private-field rule so first-match-wins claims them here.
dotnet_naming_rule.static_readonly_fields_should_be_pascalcase.severity = warning
dotnet_naming_rule.static_readonly_fields_should_be_pascalcase.symbols = static_readonly_field_symbol
dotnet_naming_rule.static_readonly_fields_should_be_pascalcase.style = pascalcase_style

dotnet_naming_symbols.static_readonly_field_symbol.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field_symbol.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_field_symbol.required_modifiers = static, readonly

# Private fields must be _camelCase. Non-const, non-static-readonly only: both are already claimed
# by the PascalCase rules above, which are declared first.
dotnet_naming_rule.private_fields_should_be_camelcase.severity = warning
dotnet_naming_rule.private_fields_should_be_camelcase.symbols = private_field_symbol
dotnet_naming_rule.private_fields_should_be_camelcase.style = underscore_camelcase_style

dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private

dotnet_naming_style.underscore_camelcase_style.required_prefix = _
dotnet_naming_style.underscore_camelcase_style.capitalization = camel_case

dotnet_naming_rule.properties_methods_should_be_pascalcase.severity = warning
dotnet_naming_rule.properties_methods_should_be_pascalcase.symbols = property_method_symbol
dotnet_naming_rule.properties_methods_should_be_pascalcase.style = pascalcase_style

dotnet_naming_symbols.property_method_symbol.applicable_kinds = property, method
dotnet_naming_symbols.property_method_symbol.applicable_accessibilities = *

dotnet_naming_style.pascalcase_style.capitalization = pascal_case

# Async methods must end with Async
dotnet_naming_rule.async_methods_should_have_async_suffix.severity = warning
dotnet_naming_rule.async_methods_should_have_async_suffix.symbols = async_method_symbol
dotnet_naming_rule.async_methods_should_have_async_suffix.style = async_suffix_style

dotnet_naming_symbols.async_method_symbol.applicable_kinds = method
dotnet_naming_symbols.async_method_symbol.applicable_accessibilities = *
dotnet_naming_symbols.async_method_symbol.required_modifiers = async

dotnet_naming_style.async_suffix_style.required_suffix = Async
dotnet_naming_style.async_suffix_style.capitalization = pascal_case

# Code-style rules promoted to build errors (Directory.Build.props sets
# EnforceCodeStyleInBuild). Unused usings are a real defect: they hide a file's
# true dependencies and survive refactors nobody reviews.
[*.cs]
dotnet_diagnostic.IDE0005.severity = error
# The naming rules above (PascalCase members, `_` private fields, the Async suffix) are declared
# with `dotnet_naming_rule.*.severity`, which the IDE and `dotnet format` honour and the COMPILER
# does not. Without this line they were advisory: the build passed with 418 violations in the tree
# and only `maran format --check` ever saw them. IDE1006 is the diagnostic those rules report
# under, so setting it here is what turns them into build errors (TreatWarningsAsErrors).
dotnet_diagnostic.IDE1006.severity = warning

# Braces are never optional. A body that grows from one statement to two is the moment a missing
# brace turns into a bug, and a reviewer should never have to notice the difference.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# The same rule applied to member bodies: no `=>` shorthand for methods, properties, constructors
# or operators — every body is a braced block.
csharp_style_expression_bodied_methods = false:error
csharp_style_expression_bodied_constructors = false:error
csharp_style_expression_bodied_operators = false:error
csharp_style_expression_bodied_properties = false:error
csharp_style_expression_bodied_indexers = false:error
csharp_style_expression_bodied_accessors = false:error
csharp_style_expression_bodied_lambdas = false:error
csharp_style_expression_bodied_local_functions = false:error
dotnet_diagnostic.IDE0021.severity = error
dotnet_diagnostic.IDE0022.severity = error
dotnet_diagnostic.IDE0023.severity = error
dotnet_diagnostic.IDE0024.severity = error
dotnet_diagnostic.IDE0025.severity = error
dotnet_diagnostic.IDE0026.severity = error
dotnet_diagnostic.IDE0027.severity = error
dotnet_diagnostic.IDE0053.severity = error
dotnet_diagnostic.IDE0061.severity = error

# EF Core writes these files and rewrites them on every schema change. Holding machine output to the
# hand-written style rules only means reformatting it after each `scripts/migrations.sh add`, and
# nobody reads a migration for its brace placement — the schema it produces is what matters.
# Correctness rules (compiler warnings, nullable, banned APIs) still apply; only style is silenced.
[**/Persistence/Migrations/*.cs]
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0021.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0023.severity = none
dotnet_diagnostic.IDE0024.severity = none
dotnet_diagnostic.IDE0025.severity = none
dotnet_diagnostic.IDE0026.severity = none
dotnet_diagnostic.IDE0027.severity = none
dotnet_diagnostic.IDE0053.severity = none
dotnet_diagnostic.IDE0061.severity = none
dotnet_diagnostic.IDE0161.severity = none
# CA1825: EF writes `new bool[0]` for a single-column descending index. It is a performance
# suggestion about an allocation that happens once, at migration time, in code we do not author.
dotnet_diagnostic.CA1825.severity = none

# Test names are behaviour sentences (`Creating_a_site_with_a_taken_domain_returns_conflict`),
# which rules/testing.md mandates and which xUnit requires to be public — so CA1707 fires on every
# one of them. The rule guards a public API surface that a test assembly does not have: nothing
# outside the solution consumes these names, and renaming them to PascalCase would trade a sentence
# a reviewer reads for a run of capitals they have to parse. The naming rule wins here; the analyser
# is told so once, in the open, instead of being silenced behind a project-wide <NoWarn>.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
# And for the same reason, the Async suffix. `Revoking_another_users_session_answers_404_rather
# _than_403Async` is not a sentence, and the suffix carries no information here: a reader of a test
# never awaits it, and xUnit does not care. In production the suffix earns its place by warning a
# caller there is a Task to await — tests have no callers.
dotnet_diagnostic.IDE1006.severity = none

# `Error` is the project-wide name for a typed domain failure (rules/csharp.md, "Errors: Result, not
# exceptions") and `Result<T>.Ok`/`Fail` are its mandated factories. CA1716 objects to `Error` only
# because it is a keyword in Visual Basic, and CA1000 would have us host the factories on a separate
# non-generic type. Both would rename the vocabulary every module and the agent client already speak,
# to satisfy rules aimed at libraries shipped to unknown callers. These two files are that vocabulary.
[src/Maran.SharedKernel/Results/*.cs]
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1000.severity = none
