{
  "//": [
    "Non-secret defaults for the public demonstration (Maran.Host.Demo). The sign-ins, the database",
    "password and the keys come from the environment file the deployment writes (demo/panel.env.example).",
    "Nothing secret ever lives here."
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Database": {
    "Host": "/var/run/postgresql",
    "Database": "maran_demo",
    "Username": "maran_demo"
  },
  "Agent": {
    "SocketPath": "/run/maran-demo/agent.sock",
    "ProbeTimeoutSeconds": 2
  },
  "RateLimiting": {
    "LoginMaxAttempts": 20,
    "LoginWindowSeconds": 60,
    "LoginLockoutSeconds": 60,
    "ApiPermitLimit": 300,
    "ApiWindowSeconds": 60,
    "SiteLogConcurrentStreamLimit": 2
  },
  "AllowedHosts": "demo-maran.innovayse.com",
  "Jwt": {
    "Issuer": "maran-demo",
    "Audience": "maran-demo-panel",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 1
  },
  "Demo": {
    "ResetIntervalHours": 2,
    "Reset": {
      "MarkerPath": "/var/lib/maran-demo/last-reset"
    }
  }
}
