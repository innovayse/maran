<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The resx triples' neutral file is English (rules/csharp.md "The backend owns all
         user-facing message text"). Declaring it lets the runtime skip probing for an "en"
         satellite assembly that will never exist, and satisfies CA1824. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- A module is a plain class library (not Microsoft.NET.Sdk.Web): it contributes
         controllers and endpoints into the Host's ASP.NET Core pipeline but never hosts
         its own web server (rules/architecture.md "Backend: modular monolith"). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- A module references only the Sdk (module contract, BaseApiController, result
         translation, IAccountDirectory) and the SharedKernel (Result, IClock, ICurrentUser) —
         never another module, never the Host (rules/architecture.md "Backend: modular
         monolith"). In particular this project does NOT reference Maran.Modules.Accounts: the
         account's system user name and its plan's cron allowance arrive through Maran.Sdk's
         IAccountDirectory, whose implementation lives in the module that owns those rows. -->
    <!-- The agent client: a cron entry exists only in the account's crontab, which only the
         agent may read or write. It is also the ONLY store this module has — see the note about
         the absent persistence packages below. -->
    <ProjectReference Include="..\..\Maran.Agent.Client\Maran.Agent.Client.csproj" />
    <ProjectReference Include="..\..\Maran.Sdk\Maran.Sdk.csproj" />
    <ProjectReference Include="..\..\Maran.SharedKernel\Maran.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WolverineFx: command/query dispatch. FluentValidation: command/query validators
         (rules/csharp.md "Operation naming is fixed").

         There is deliberately NO Npgsql, no EF Core and no PostgreSQL schema. Every other module
         so far owns a schema and a DbContext; this one owns neither, because the account's
         crontab IS the record and the account can edit it directly over SFTP. A panel table
         beside it would be a second answer to "what does this account run", stale from the first
         time the customer edited their own crontab — and the panel's copy is the one an operator
         would trust. The absence is the design, not an omission to be tidied up later. -->
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resx-backed user-facing message text (rules/csharp.md "The backend owns all
         user-facing message text"), one file per purpose rather than one catch-all: ErrorMessages
         for domain failures surfaced as error codes, DisplayNames for the module's own name.
         ErrorMessages is strongly typed so Error.Of(nameof(ErrorMessages.CronEntryNotFound)) fails
         to compile when the key is absent — the codes ARE the resx keys, with no second
         declaration. -->
    <EmbeddedResource Update="Resources\ErrorMessages.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Maran.Modules.Cron.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ErrorMessages</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)ErrorMessages.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
