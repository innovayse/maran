<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The resx triples' neutral file is English (rules/csharp.md "The backend owns all
         user-facing message text"). Declaring it lets the runtime skip probing for an "en"
         satellite assembly that will never exist, and satisfies CA1824. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- A module is a plain class library (not Microsoft.NET.Sdk.Web): it contributes
         controllers and endpoints into the Host's ASP.NET Core pipeline but never hosts
         its own web server (rules/architecture.md "Backend: modular monolith"). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- A module references only the Sdk (module contract, BaseApiController, result translation,
         the audit journal, the SendMailRequested contract it publishes and the
         IAlertRecipientDirectory contract it reads) and the SharedKernel (Result, IClock,
         ICurrentUser) — never another
         module, never the Host (rules/architecture.md "Backend: modular monolith"). -->
    <!-- The agent client: every figure this module stores is one only the agent can read. Nothing
         in this process can see the host's processor, memory, filesystem or service manager. -->
    <ProjectReference Include="..\..\Maran.Agent.Client\Maran.Agent.Client.csproj" />
    <ProjectReference Include="..\..\Maran.Sdk\Maran.Sdk.csproj" />
    <ProjectReference Include="..\..\Maran.SharedKernel\Maran.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL: the module owns its PostgreSQL schema and
         DbContext (rules/architecture.md), and the chart query's date_bin bucketing is
         PostgreSQL's own. WolverineFx: command/query dispatch and publishing
         SendMailRequested. FluentValidation: command and query validators (rules/csharp.md
         "Operation naming is fixed"). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resx-backed user-facing message text (rules/csharp.md "The backend owns all
         user-facing message text"), one file per purpose rather than one catch-all: DisplayNames
         for the module's own name, NotificationMessages for the words of the alert mail it asks
         the Notifications module to send. There is deliberately no ErrorMessages triple: every
         error code this module used to define was an SMTP one and moved out with the mailer, and
         a file appears when its purpose does (rules/csharp.md). -->
    <EmbeddedResource Update="Resources\DisplayNames.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NotificationMessages.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NotificationMessages.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NotificationMessages.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
