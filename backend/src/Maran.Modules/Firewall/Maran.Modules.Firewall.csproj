<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The resx triples' neutral file is English (rules/csharp.md "The backend owns all
         user-facing message text"). Declaring it lets the runtime skip probing for an "en"
         satellite assembly that will never exist, and satisfies CA1824. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- A module is a plain class library (not Microsoft.NET.Sdk.Web): it contributes
         controllers and endpoints into the Host's ASP.NET Core pipeline but never hosts
         its own web server (rules/architecture.md "Backend: modular monolith"). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- A module references only the Sdk (module contract, BaseApiController, result
         translation, the audit journal) and the SharedKernel (Result, IClock, ICurrentUser) —
         never another module, never the Host (rules/architecture.md "Backend: modular
         monolith"). This module deliberately does NOT reference Maran.Sdk's IAccountDirectory
         either: a firewall rule, a ban and a whitelist row are facts about the SERVER, owned by
         its administrator, with no tenant to scope them to. -->
    <!-- The agent client: nothing in the host's packet filter can be reached from this process,
         so every rule and every ban is the agent's to install. What lives here is the record of
         WHY a ban was placed and when it should end, which the agent deliberately does not keep. -->
    <ProjectReference Include="..\..\Maran.Agent.Client\Maran.Agent.Client.csproj" />
    <ProjectReference Include="..\..\Maran.Sdk\Maran.Sdk.csproj" />
    <ProjectReference Include="..\..\Maran.SharedKernel\Maran.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL: the module owns its PostgreSQL schema and
         DbContext (rules/architecture.md). WolverineFx: command/query dispatch and the
         BruteForceDetected subscription. FluentValidation: command validators
         (rules/csharp.md "Operation naming is fixed"). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resx-backed user-facing message text (rules/csharp.md "The backend owns all
         user-facing message text"), one file per purpose rather than one catch-all: ErrorMessages
         for domain failures surfaced as error codes, DisplayNames for the module's own name.
         ErrorMessages is strongly typed so Error.Of(nameof(ErrorMessages.BanNotFound)) fails to
         compile when the key is absent — the codes ARE the resx keys, with no second
         declaration. -->
    <EmbeddedResource Update="Resources\ErrorMessages.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Maran.Modules.Firewall.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ErrorMessages</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)ErrorMessages.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
