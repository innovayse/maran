<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The resx triples' neutral file is English (rules/csharp.md "The backend owns all
         user-facing message text"). -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- A module is a plain class library (not Microsoft.NET.Sdk.Web): it contributes DI
         registrations into the Host's container but never hosts its own web server
         (rules/architecture.md "Backend: modular monolith"). Needed directly here (not merely
         transitively through Maran.Sdk) for Microsoft.Extensions.DependencyInjection.IServiceCollection
         and Microsoft.Extensions.Configuration.IConfiguration in LicensingModule. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- A module references only the Sdk (module contract, BaseApiController, result translation)
         and the SharedKernel (Result, IClock, ICurrentUser) — never another module, never the Host
         (rules/architecture.md "Backend: modular monolith"). This slice's read-only status endpoint
         needs neither EF Core nor the agent client: persistence and the closed PluginLoader seam
         are explicitly out of scope, see the module's log entry in docs/superpowers/notes/
         2026-09-22-licence-verification-threat-note.md. -->
    <ProjectReference Include="..\..\Maran.Sdk\Maran.Sdk.csproj" />
    <ProjectReference Include="..\..\Maran.SharedKernel\Maran.SharedKernel.csproj" />
    <!-- The licence names one server, and only the agent can say which server this is: the
         machine-id lives in a root-owned file the panel process cannot read. Ten sibling
         modules take this same reference for the same reason. -->
    <ProjectReference Include="..\..\Maran.Agent.Client\Maran.Agent.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ed25519 verification only; no home-grown crypto (rules/security.md item 9) and the BCL has
         no Ed25519 support on net9.0 — see the pin's comment in Directory.Packages.props.
         WolverineFx: the status query and the install command are dispatched through the bus like
         every other module's, now that this module is in the ModuleRegistry that Wolverine's handler
         discovery walks (it has a screen, so it is no longer deliberately absent from it). -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="WolverineFx" />
    <!-- FluentValidation: InstallLicenceCommandValidator's one request-shape rule
         (rules/security.md "Input"), the same package every other module's command validators use. -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <!-- The production licence verification key, embedded only when the release has one. The file is
         the 64 hexadecimal characters of the Ed25519 PUBLIC key, generated offline by the issuing
         service (its private half never enters this repository). Until it exists, a build trusts no
         key and refuses every licence (EmbeddedLicenceVerificationKeySource); no placeholder is
         ever embedded in its stead. -->
    <EmbeddedResource Include="..\..\..\..\installer\keys\licence-verification.pub"
                      Condition="Exists('..\..\..\..\installer\keys\licence-verification.pub')"
                      LogicalName="licence-verification.pub" />
  </ItemGroup>

  <ItemGroup>
    <!-- The production lease verification key, embedded only when the release has one. A different key
         from the licence key on purpose (a leaked lease key must not mint licences, and the reverse).
         The file is the 64 hexadecimal characters of the Ed25519 PUBLIC key, generated offline by the
         issuing service; until it exists a build refuses every lease, and no placeholder is embedded. -->
    <EmbeddedResource Include="..\..\..\..\installer\keys\lease-verification.pub"
                      Condition="Exists('..\..\..\..\installer\keys\lease-verification.pub')"
                      LogicalName="lease-verification.pub" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resx-backed user-facing message text (rules/csharp.md "The backend owns all user-facing
         message text"), one file per purpose: ErrorMessages for InstallLicenceCommandHandler's five
         distinguishable refusal codes plus the validator's one shape code, DisplayNames for the
         read-only status surface's sentences and the module's own name. ErrorMessages is strongly
         typed so Error.Of(nameof(ErrorMessages.LicenceInstallMalformed)) fails to compile when the
         key is absent — the codes ARE the resx keys, with no second declaration, the same shape
         Databases.Resources.ErrorMessages already uses. -->
    <EmbeddedResource Update="Resources\ErrorMessages.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Maran.Modules.Licensing.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ErrorMessages</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)ErrorMessages.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DisplayNames.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NotificationMessages.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NotificationMessages.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NotificationMessages.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
