<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The resx triples' neutral file is English (rules/csharp.md "The backend owns all
         user-facing message text"). Declaring it lets the runtime skip probing for an "en"
         satellite assembly that will never exist, and satisfies CA1824. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <!-- DI.Abstractions: only for the AddAgentClient registration entry point (DependencyInjection.cs). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <Protobuf Include="../../../proto/agent/v1/*.proto" ProtoRoot="../../../proto" GrpcServices="Client" />
    <ProjectReference Include="../Maran.SharedKernel/Maran.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resx-backed user-facing message text (rules/csharp.md "The backend owns all
         user-facing message text"): ErrorMessages carries the customer-readable sentence for every
         agent failure code this project produces. Strongly-typed generation is not needed — the
         keys are looked up by code through IErrorTextProvider, never by a designer accessor. -->
    <EmbeddedResource Update="Resources\ErrorMessages.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Maran.Agent.Client.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ErrorMessages</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)ErrorMessages.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.ru.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ErrorMessages.hy.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maran.Agent.Client.Tests" />
  </ItemGroup>

</Project>
