<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Maran.Sdk is the subject. Maran.Host is referenced for what it drags in rather than for
         itself: it is the composition root that references every shipped module and the agent
         client, so its output directory is the one place that holds EVERY assembly carrying an
         embedded ErrorMessages resource. The census test enumerates those assemblies from disk
         instead of naming them, so a module added to the panel is discovered here without anyone
         remembering to add it. -->
    <ProjectReference Include="..\..\src\Maran.Sdk\Maran.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Maran.Host\Maran.Host.csproj" />
  </ItemGroup>

</Project>
