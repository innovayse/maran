<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test code is exempt from XML doc comments (rules/testing.md) and uses
         behavior-sentence method names with underscores by convention, so the
         corresponding analyzer warnings do not apply to this project. -->
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maran.Host\Maran.Host.csproj" />
    <ProjectReference Include="..\..\src\Maran.Sdk\Maran.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Maran.SharedKernel\Maran.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Maran.Agent.Client\Maran.Agent.Client.csproj" />
    <ProjectReference Include="..\..\src\Maran.Modules\Accounts\Maran.Modules.Accounts.csproj" />
    <ProjectReference Include="..\..\src\Maran.Modules\Identity\Maran.Modules.Identity.csproj" />
  </ItemGroup>

</Project>
