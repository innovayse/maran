# Every environment variable the panel reads during local development.
#
# `source scripts/dev` copies this to `.env` (git-ignored) the first time and exports every line;
# edit `.env`, not this file. Nothing here is a real secret: production values are
# generated on the customer's server by the installer and written to /etc/maran/panel.env
# (root:panel 0640) — see installer/panel.env.example for that file's shape.
#
# .NET maps a `__` in a variable name to configuration nesting: Security__EncryptionKey sets the
# "Security:EncryptionKey" setting, overriding appsettings*.json.

# Which appsettings file the host layers on top of appsettings.json.
ASPNETCORE_ENVIRONMENT=Development

# Base64-encoded 256-bit key used to encrypt secrets at rest. Startup refuses to boot without a
# valid one. The value below is a well-known development key — never use it on a server.
Security__EncryptionKey=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Base64 key access tokens are signed with. Development value only: a server's key is generated by
# the installer and never leaves it.
Jwt__SigningKey=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# One-time token authorizing creation of the first administrator, at /setup. On a server the
# installer generates it and prints the link to the operator's terminal; here it is a fixed
# development value. It stops working the moment the panel has a user, whatever it is set to.
Setup__Token=dev-setup-token

# The panel's own public address, used to build the link in a password-reset mail. Deliberately
# configuration rather than the request's Host header: that header is supplied by the caller, and a
# reset link built from it points wherever an attacker says, in the panel's own name, carrying a
# live token. Leave it empty and the mail carries the token to paste instead of a link — worse to
# use, and safe.
PasswordReset__PanelUrl=https://localhost:5173

# Panel database, one key per part — never a single connection string: parts can be overridden
# individually, and a value containing a semicolon cannot corrupt the rest. Matches
# docker/docker-compose.dev.yml. Production connects over a unix socket instead (see
# installer/panel.env.example).
Database__Host=localhost
Database__Port=5432
Database__Database=maran_dev
Database__Username=maran_dev
Database__Password=maran_dev

# Path to the agent's unix domain socket. No agent runs locally, so the health endpoint reports it
# unavailable — that is the honest state during API and frontend work.
Agent__SocketPath=/run/maran/agent.sock

# Rate limits. Development values are deliberately wide so clicking around and e2e runs are not
# throttled; the production defaults live in appsettings.json.
RateLimiting__LoginMaxAttempts=50
RateLimiting__ApiPermitLimit=5000

# The password-reset bucket, its own limiter because the endpoint is anonymous and every request
# makes the panel send mail with the operator's return address on it. In production it is the only
# stated bound on account enumeration through that endpoint (three requests per fifteen minutes per
# source address), so it is the knob to reach for if the endpoint is ever reported as a vector —
# with the caveat that a per-address bucket does not bound an attacker holding many addresses.
RateLimiting__PasswordResetMaxRequests=50
RateLimiting__PasswordResetWindowSeconds=900

# ACME (Let's Encrypt and compatible authorities), used when a certificate is issued for a site.
#
# STAGING by default in development, deliberately. Production issuance is rate-limited per
# registered domain per week, and a developer looping on an issuance bug orders the same
# certificate a dozen times — burning a limit that then blocks a real customer for days. Staging
# issues untrusted certificates, which is the right feedback: the whole flow runs and the browser
# says out loud that this is not a real certificate.
Acme__DirectoryUrl=https://acme-staging-v02.api.letsencrypt.org/directory

# Operator contact registered with the authority, so it can warn about expiries and account
# problems. An operator address, never a customer's.
Acme__ContactEmail=dev@localhost

# Where the AGENT keeps certificate material. Outside every account's home: a site's PHP runs as
# that customer, so a key readable from inside the home is a key the site itself could read.
Acme__CertificateStorePath=/var/lib/maran/certs

# The two host facts the panel cannot see for itself, and which its Firewall module refuses to
# boot without. The agent re-renders the WHOLE nftables ruleset on every mutation and the rendered
# policy is drop, so these decide whether the operator's own SSH session and the panel itself
# survive the next rule change. `FirewallOptionsValidator` refuses startup rather than defaulting
# either one, because a silently-defaulted port IS the lockout.
#
# On a real server the installer detects both and writes them into /etc/maran/panel.env; the
# values here are development defaults and match installer/panel.env.example.
#
# SshPorts is a LIST, comma-separated, and the plural is the safety property: sshd listens on every
# `Port` directive and every `ListenAddress host:port`, across sshd_config and everything its
# `Include` pulls in. A dev box serving sshd on 2222 as well would write `22,2222`.
Firewall__SshPorts=22

# The PUBLIC port of the panel's nginx vhost — never the port the api itself listens on. Opening
# that one leaves the panel reachable until the first rule change and unreachable afterwards.
#
# On a real server the api has no such port to confuse this with: it listens on the unix socket
# /run/maran-api/api.sock and on nothing else, because a loopback port is reachable by every uid on
# the machine and everything that reaches it arrives with the address the panel trusts as its
# proxy. Development still runs it on 127.0.0.1:5080 for the Vite proxy's sake, so a dev checkout
# has the exposure a server does not — the api logs a warning saying so on every boot.
Firewall__PanelPort=8443

# The address a real installer was run from, seeded as the first firewall whitelist row so that the
# anti-brute-force feature cannot ban the operator who installed the panel. Read ONCE, when the
# whitelist is empty; after that the whitelist is panel data and editing this changes nothing.
#
# Empty in development, and that is the honest value: nobody installed this checkout over SSH, so
# there is no address to exempt. An empty whitelist is not a boot failure — unlike the two ports
# above, nothing is rendered from it — so leaving it blank costs nothing until you want to exercise
# the seeder, which takes a single-host CIDR (`203.0.113.7/32`, or `/128` for IPv6).
Firewall__SeedWhitelistCidr=
