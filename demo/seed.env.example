# /etc/maran-demo/seed.env: read by bin/maran-demo-deploy for the seed verbs only (root:root 0600). The
# maran-demo-api service does NOT load this file, so the long-running process never holds the token.

# The one-time token the seed uses to complete setup on the template database. Generated for the seed run;
# replace it with a new random value before each deployment. Never a real or reused secret.
Setup__Token=
