# /etc/maran-demo/panel.env on the demo server (root:maran-demo, mode 0640).
#
# Names, comments and safe placeholders only (rules/security.md item 7). Every secret below is generated
# for THIS deployment with `openssl rand -base64 32` and is never reused from a real install, never
# committed, and never shown to a visitor. The only values a visitor sees are the two published
# sign-ins, which are public by design and carry no authority outside the demonstration.

# The key every encrypted column is sealed with. A new one per deployment.
Security__EncryptionKey=

# The key access tokens are signed with. A new one per deployment; replacing it signs everyone out.
Jwt__SigningKey=

# The database. The panel talks to PostgreSQL over its unix socket and holds no password.
Database__Host=/var/run/postgresql
Database__Database=maran_demo
Database__Username=maran_demo

# Where the API listens, and the one uid it accepts there (the web server's). The same shape the
# product install uses, for the same reason (installer/panel.env.example).
ASPNETCORE_URLS=http://unix:/run/maran-demo-api/api.sock
ReverseProxy__PeerUid=33

# Host facts the firewall module is told. The simulated server enforces nothing, but the module
# validates its own settings at start.
Firewall__SshPorts=22
Firewall__PanelPort=443

# The name and address the demonstration answers to.
Panel__HostName=demo-maran.innovayse.com
Panel__PublicUrl=https://demo-maran.innovayse.com

# The one-time setup token the seed needs is NOT here: it lives in /etc/maran-demo/seed.env
# (demo/seed.env.example), which only the deploy script reads. This file is the service's environment, and
# a long-running process must not carry a value that permits becoming the administrator.

# The two published sign-ins. Generated per deployment, printed by the status endpoint and the login
# page, and never written in source. The customer's login name is the featured account's name.
Demo__Identities__AdministratorUsername=demoadmin
Demo__Identities__AdministratorEmail=admin@demo.example.com
Demo__Identities__AdministratorPassword=
Demo__Identities__CustomerPassword=

# Where a visitor reports abusive content: one bare e-mail address or one https URL (a role mailbox of the
# operator, never a person). REQUIRED: the demonstration refuses to start without it. The banner prints it in
# every language and the status endpoint returns it. This value is a placeholder; set the operator's own.
Demo__AbuseContact=abuse@innovayse.com

# How often the demonstration returns to the seed, and where the moment of the last reset is kept.
Demo__ResetIntervalHours=2
Demo__Reset__MarkerPath=/var/lib/maran-demo/last-reset

# Starting values of the abuse budgets (threat note T6); re-measure against a running demo.
Demo__GlobalMutationBudget=5000
Demo__VisitorMutationsPerWindow=60
Demo__VisitorWindowSeconds=60
# Sign-ins, refreshes and sign-outs per window: per visitor (an IPv4 address or an IPv6 /64) and for the whole
# demo. They write session and audit rows, so they are bounded apart from the mutation budget.
Demo__VisitorSignInsPerWindow=20
Demo__GlobalSignInsPerWindow=600
