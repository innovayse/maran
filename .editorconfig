# Repository-wide editor and formatting settings for Maran.
# Normative: rules/csharp.md, rules/rust.md, rules/vue.md, rules/proto.md.
# Stack-specific analyzer and naming rules live in backend/.editorconfig.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# C# — full style and naming rules are in backend/.editorconfig
[*.{cs,csx}]
indent_size = 4

# Rust — rustfmt defaults
[*.rs]
indent_size = 4

# Frontend and configuration formats
[*.{ts,tsx,js,mjs,cjs,vue,css,scss,html}]
indent_size = 2

[*.{json,jsonc,json5,yml,yaml,toml}]
indent_size = 2

[*.{xml,csproj,props,targets,resx,config}]
indent_size = 2

[*.proto]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
shell_variant = bash
binary_next_line = true
switch_case_indent = true

[*.md]
indent_size = 2
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated or vendored content is not ours to format.
[{**/bin/**,**/obj/**,**/target/**,**/node_modules/**,**/dist/**}]
insert_final_newline = false
trim_trailing_whitespace = false
