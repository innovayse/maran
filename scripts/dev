#!/usr/bin/env bash
# Puts Maran's user-local developer toolchains (dotnet 9, rustup/cargo, protoc) on
# PATH ahead of any system-wide versions (e.g. an older distro dotnet). Must be sourced,
# not executed, so the exports reach the calling shell: `source scripts/dev`.
# Sourcing is the whole point, and this directory is on PATH — so `dev` can be TYPED as a
# command, where it would set variables in a subprocess that exits immediately and appear to
# have done nothing. Refusing loudly is the difference between a puzzling half-hour and a line
# of output.
if [ "${BASH_SOURCE[0]:-}" = "${0}" ]; then
  echo "dev must be sourced, not run: it sets variables in the calling shell." >&2
  echo "  source scripts/dev" >&2
  exit 1
fi

export PATH="$HOME/.dotnet:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
export DOTNET_ROOT="$HOME/.dotnet"

# WHAT THIS FILE GUARANTEES, and what it does not — stated because a reader who assumes the list is
# complete draws the wrong conclusion about a gate that refused. Guaranteed, at the three paths
# above: the dotnet SDK, cargo and rustc, protoc. NOT guaranteed: **node and npm**, and
# deliberately. They are installed per-version here (a version manager's
# `~/.nvm/versions/node/<exact version>/bin`) and by `actions/setup-node` in CI, so the only way to
# name them from this file would be to hard-code one machine's version — which would work here,
# break on the next developer's machine and, worse, break invisibly in CI by putting a directory
# that does not exist ahead of the one the runner set up. A path that is true in only one place is
# worse than no path. The developer's own profile supplies them; every gate that needs them refuses
# by name when it cannot find them (scripts/lib/suite.sh `suite_require_toolchain`, and the guards
# in api-contract.sh, format.sh and licenses.sh), which is the honest half of this arrangement.
#
# Nor is `DOTNET_ROOT` above a thing CI wants. On a runner `setup-dotnet` installs the SDK
# elsewhere and prepends its own PATH, so exporting this would point .NET at a directory that does
# not exist. That is exactly why the counting gates — test-verdict.sh, mutate.sh — do NOT source
# this file and prove their toolchain instead: sourcing it would have to be right in two
# environments, and proving it only has to be right in one.

# This repository's own toolbox, so `maran <command>` works from any directory inside it rather
# than only from the root as `./scripts/maran`. Resolved from this file's location and not from
# the current directory: sourcing happens once, and the shell keeps the value long after the
# developer has cd'd into backend/ or frontend/.
#
# BASH_SOURCE, not $0: when a file is SOURCED, $0 is still the shell's own name, so $0 would
# resolve to the interactive shell instead of this script.
MARAN_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export PATH="$MARAN_SCRIPTS:$PATH"
unset MARAN_SCRIPTS

# `.env` is where local configuration lives: the development encryption key, the JWT signing key,
# the setup token, the database and the agent socket. `.env.example` had always said "copy this to
# .env" while nothing read the result, so the copy changed nothing and the values that actually
# applied came from appsettings.Development.json — two sources for one setting, and the tracked one
# won. Now there is one source, it is git-ignored, and it is created here on first use.
#
# .NET maps `__` in a variable name to configuration nesting, so `Jwt__SigningKey` sets the
# "Jwt:SigningKey" setting and overrides appsettings*.json.
MARAN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
MARAN_ENV_FILE="$MARAN_ROOT/.env"
if [ ! -e "$MARAN_ENV_FILE" ] && [ -r "$MARAN_ROOT/.env.example" ]; then
  cp "$MARAN_ROOT/.env.example" "$MARAN_ENV_FILE"
  echo "created .env from .env.example — development values, safe to edit, never committed" >&2
fi
unset MARAN_ROOT

# Read line by line rather than sourced: a sourced file would execute whatever it contains, and a
# config file must not be able to run commands in the developer's shell.
#
# THE ENVIRONMENT WINS OVER THE FILE. A value already set in the caller's environment is left
# alone; only names this file has not yet supplied are exported. That is standard dotenv
# semantics, and here it closes a real defect: the `maran` commands that need a toolchain source
# this file themselves, `maran migrate` among them, so
# `Database__Database=maran_scratch maran migrate apply Accounts` had its override silently
# replaced by `.env`'s value on the next line, and the migration landed in the configured
# database instead — measured writing into another session's database.
#
# "The commands that need one", not every command: this used to read "every `maran` command sources
# this file" and that was never true, which matters because it is the sentence a reader would use
# to conclude that `maran test` inherits the pinned dotnet. It does not. Eight scripts source this
# file — agent.sh, e2e-handshake.sh, format.sh, licenses.sh, migrations.sh, preflight.sh,
# run-dev.sh, schema-drift.sh — and the rest run on whatever PATH the caller had. What protects the
# ones that do not is `suite_require_toolchain` (scripts/lib/suite.sh), which refuses rather than
# measuring with the wrong compiler: a bare-PATH `dotnet` here is the 8.0 snap at /snap/bin/dotnet,
# and two lanes lost their counts to `NETSDK1045` before that guard existed.
#
# MARAN_ENV_APPLIED remembers which names came from the file, so re-sourcing after an edit still
# picks the edit up (the file may overwrite its own earlier value) while a genuine override from
# the caller is never touched. It is exported because the override must survive into the
# subprocesses — `maran`, and the scripts it runs — that source this file again.
if [ -r "$MARAN_ENV_FILE" ]; then
  while IFS= read -r maran_env_line || [ -n "$maran_env_line" ]; do
    case "$maran_env_line" in
      ''|'#'*) continue ;;
      *=*)
        maran_env_name="${maran_env_line%%=*}"
        # Set by someone other than this file? Then it is an override, and it stands.
        if [ -n "${!maran_env_name+set}" ] &&
           ! case " ${MARAN_ENV_APPLIED:-} " in *" $maran_env_name "*) true ;; *) false ;; esac; then
          continue
        fi
        export "$maran_env_name=${maran_env_line#*=}"
        case " ${MARAN_ENV_APPLIED:-} " in
          *" $maran_env_name "*) : ;;
          *) MARAN_ENV_APPLIED="${MARAN_ENV_APPLIED:-} $maran_env_name" ;;
        esac
        ;;
    esac
  done < "$MARAN_ENV_FILE"
  export MARAN_ENV_APPLIED
  unset maran_env_line maran_env_name
fi
unset MARAN_ENV_FILE

# GitHub API token for reading CI runs and pushing, kept OUTSIDE the repository so it can never
# be committed: ~/.config/maran/github-token, mode 0600. Create it with:
#   mkdir -p ~/.config/maran && printf '%s\n' "<token>" > ~/.config/maran/github-token
#   chmod 600 ~/.config/maran/github-token
if [ -r "$HOME/.config/maran/github-token" ]; then
  GH_TOKEN="$(cat "$HOME/.config/maran/github-token")"
  export GH_TOKEN
  export GITHUB_TOKEN="$GH_TOKEN"
fi
