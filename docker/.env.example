# Settings for the development-only compose stack (docker/docker-compose.dev.yml).
#
# Copy to `docker/.env` (git-ignored) if you want different values; the compose file falls back to
# these defaults when no .env is present, so a fresh clone works without any setup.
#
# These credentials are development-only and grant nothing anywhere else. Production never runs
# PostgreSQL in a container — the installer sets it up natively, listening on a unix socket only.

POSTGRES_USER=maran_dev
POSTGRES_PASSWORD=maran_dev
POSTGRES_DB=maran_dev

# Host port the development database is published on. Change it if 5432 is already taken by a
# PostgreSQL you run natively.
POSTGRES_PORT=5432
