# Settings for the development-only compose stack (docker/docker-compose.dev.yml).
#
# Copy to `docker/.env` (git-ignored) if you want different values; the compose file falls back to
# these defaults when no .env is present, so a fresh clone works without any setup.
#
# These credentials are development-only and grant nothing anywhere else. Production never runs
# PostgreSQL in a container — the installer sets it up natively, listening on a unix socket only.

POSTGRES_USER=maran_dev
POSTGRES_PASSWORD=maran_dev
POSTGRES_DB=maran_dev

# Host port the development database is published on. Change it if 5432 is already taken by a
# PostgreSQL you run natively.
POSTGRES_PORT=5432

# ACME, for the API container. Staging by default, for the reason the repository-root .env.example
# gives: production issuance is rate-limited and a development loop would burn that budget.
Acme__DirectoryUrl=https://acme-staging-v02.api.letsencrypt.org/directory
Acme__ContactEmail=dev@localhost
Acme__CertificateStorePath=/var/lib/maran/certs

# The agent service's container name and the host directory its socket is bind-mounted from.
# Normally NOT set by hand: scripts/lib/run-dev.sh exports both — the defaults for `maran dev`,
# and a second set (maran-selfcheck-agent, .dev-agent/selfcheck) for `maran dev --selfcheck`, so
# the self-check can stand a whole second stack up beside a running one instead of fighting it.
MARAN_AGENT_CONTAINER=maran-agent-dev
MARAN_AGENT_SOCKET_DIR=../.dev-agent
