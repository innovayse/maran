# Shape of /etc/maran/panel.env — the production configuration file.
#
# This file is NOT copied to a server. The installer GENERATES panel.env during step 60-config,
# with a freshly generated encryption key, and writes it root:panel 0640 so only root and the
# panel service can read it. It is kept here so an operator can see what the installer produces
# and what may safely be edited by hand afterwards.
#
# Anything in this file is a secret or a machine-specific value. Non-secret defaults belong in
# backend/src/Maran.Host/appsettings.json, which ships with the product.

# Base64-encoded 256-bit key encrypting secrets at rest. Generated per installation.
# NEVER copy a key between servers, and never rotate it by hand: rotating without re-encrypting
# makes every stored secret unreadable. The panel refuses to start without a valid key.
Security__EncryptionKey=

# Base64 key the panel's access tokens are signed with. Generated per installation and preserved
# across re-runs: it is not used to encrypt anything, so rotating it destroys no data — but every
# issued token stops verifying at once, which signs every operator out mid-upgrade.
Jwt__SigningKey=

# Panel database, one key per part rather than a single connection string: an operator changing a
# database name or role edits one line without re-quoting a blob. Production connects over the
# local unix socket — Host is the socket DIRECTORY, no port and no password are involved, and
# PostgreSQL authenticates the panel by its operating-system user (peer authentication).
Database__Host=/var/run/postgresql
Database__Database=maran
Database__Username=panel

# Port and password are intentionally absent above, not forgotten:
#   - Port applies only to a TCP host. When Database__Host is a directory (a unix socket), the
#     panel omits the port entirely; setting one would make it attempt a TCP connection instead.
#   - Password is empty because the socket connection is authenticated by the operating-system
#     user (peer authentication) — there is no password to store, rotate or leak.
# Uncomment BOTH only if you deliberately move the database to another host, which also means
# exposing PostgreSQL on the network — a decision to make consciously, not by editing one line:
# Database__Port=5432
# Database__Password=

# One-time token that authorizes creating the first administrator in the browser. The installer
# prints the setup link on the terminal only — deliberately not in the install log. The token
# stops working once the first administrator exists.
Setup__Token=

# Where the api listens. A unix domain socket, and no TCP port at all: nginx terminates TLS on
# 8443 and reaches the api through this file. Change it together with the upstream in the nginx
# vhost — the two are the ends of one socket, and a mismatch is a panel that answers 502.
#
# The socket rather than a port is the panel's trust boundary, and it is worth knowing why. A
# loopback port is reachable by every uid on the machine, and a process that reaches it connects
# with source address 127.0.0.1 — exactly the address the panel trusts as its reverse proxy — so
# its X-Forwarded-For was honoured. Since the panel gives customers local execution (cron entries,
# and a PHP pool that permits curl_exec and fsockopen), that meant any customer could choose the
# address the panel wrote into its audit journal and partitioned its login rate limit on: forged
# audit rows, and an administrator lockout attributed to somebody else's address. A socket is
# admitted by the kernel, on the permissions of the directory holding it and on the connecting
# process's real uid, and a caller can choose neither.
#
# The socket lives in /run/maran-api, built at mode 2710 owned by panel and the web server's group
# by /etc/tmpfiles.d/maran-api.conf before the api starts: no other user on the machine can even
# traverse into it. The api narrows the socket itself to 0660 once it is bound, because Kestrel
# creates it with whatever mode the umask gives.
ASPNETCORE_URLS=http://unix:/run/maran-api/api.sock

# The uid of the web server process, and the only caller the api accepts on that socket. Resolved
# by the installer from the family's nginx user (www-data on Debian, nginx on RHEL), because a uid
# is assigned by the machine and cannot be known before the package is installed. Not a secret.
#
# Absent, it does NOT mean "accept anybody": the api refuses to start when it is bound to a socket
# and this is missing, and refuses every socket caller while it is. The panel has produced the
# opposite defect once already — an empty known-proxy list means "skip the check", not "trust
# nobody" — and the shape is deliberately not repeated.
ReverseProxy__PeerUid=33

# Three host facts the firewall is told, because nothing inside the panel can see them. All three
# are written by the installer, which is the only participant standing on the machine while the
# server can still be reached; none of them is a secret, and they live here because this file is
# already the channel through which the installer hands the panel what it observed at install time.

# Every port this host's own sshd listens on, comma-separated and ascending; 22 when its configuration
# names none. The firewall keeps an unconditional allow for each, so that no rule an administrator
# writes can cut off the last way back into the server.
#
# Plural, and the plural is the safety property: sshd listens on EVERY Port directive it is given,
# not the first, and `ListenAddress 0.0.0.0:2222` sets one too. Any rule for picking just one is a
# lockout for whoever connects on the port that was dropped, so the firewall allows the union — a
# port sshd is not using costs nothing to allow, and one it IS using costs the server.
#
# The installer collects them from /etc/ssh/sshd_config AND everything it includes. That last part
# matters more than it sounds: Ubuntu and Debian ship `Include /etc/ssh/sshd_config.d/*.conf` as the
# first line of sshd_config, so on those systems a modern port override is a drop-in file and a
# reader that stopped at the main file would report 22 for a host serving sshd on 2222 alone.
Firewall__SshPorts=22

# The public port of the panel's own nginx vhost — the `listen` line in installer/nginx/maran.conf.
# The firewall allows it unconditionally too, for the same reason.
#
# That `listen` line is a literal, and the installer does NOT rewrite it: a configuration file
# interpolates no shell variable. MARAN_PANEL_PORT in install.sh is the authority every other reader
# derives from, and the vhost is held to it by an assertion in the polygon image build, which fails
# when the two disagree. Changing the port therefore means editing both, and the build says so.
#
# The api has no port of its own to confuse this with any more — it listens on the unix socket
# named in ASPNETCORE_URLS above. That confusion used to be the trap here: opening Kestrel's own
# loopback port in a default-drop firewall would leave the panel reachable right after the install
# — nginx's port having survived only because nothing was dropping yet — and unreachable the
# moment anything changed a rule, with nobody able to log in and fix it.
Firewall__PanelPort=8443

# The address the installer was run from, as a single-host CIDR (/32 for IPv4, /128 for IPv6),
# validated to be a real address rather than merely to look like one — a malformed row would match
# no packet that ever arrives, and an operator reading it back would believe they were exempt from
# the automatic bans while they were not. It becomes the first row of the firewall whitelist, so
# that the anti-brute-force feature cannot ban the operator who installed the panel — an empty
# whitelist on day one is a server whose administrator locks themselves out by mistyping a password.
#
# The plain spelling, even on a dual-stack host: sshd there reports an ordinary IPv4 client as
# ::ffff:203.0.113.7, and this line records 203.0.113.7/32, which is the same machine and is the
# form the panel matches against — it normalises every address it compares to plain IPv4 before
# comparing. If you edit this by hand, write the plain form too; the installer warns at the end
# when the value here is one the panel would refuse.
#
# Read once, on the first start that finds an empty whitelist, and never again: the panel records
# that it has read this value in a table of its own, so deleting the seeded row does not bring the
# exemption back at the next restart. Editing this line afterwards therefore changes nothing,
# because the whitelist is panel data from then on. The installer takes it from the first field of
# SSH_CLIENT, and when sudo has dropped that variable on the way to root — its default env_reset
# does, and the installer's documented usage is `sudo bash install.sh` — from the environment of
# the nearest ancestor process that still has it.
#
# That search stops at the boundary of the login session it is running in. A tmux or screen server
# is an ancestor of every pane it owns and carries the address of whichever session started it, which
# may be a different operator on a different machine days ago; it runs in a session of its own, so it
# is not consulted. Installing from inside tmux therefore behaves like a local install, below —
# deliberately, because from in there nothing can tell which address this operator arrived on.
#
# A console or otherwise local install genuinely has no client address: nothing is written, the
# installer ends with a warning saying so, and the whitelist stays empty until an administrator adds
# a row in the panel.
Firewall__SeedWhitelistCidr=

# ACME (Let's Encrypt and compatible authorities), used when a certificate is issued for a site.
#
# PRODUCTION here, unlike development, which defaults to staging: a server issues certificates that
# browsers must actually trust. Point this at the staging directory only to test a server's own
# issuance path, and expect untrusted certificates while it is set.
Acme__DirectoryUrl=https://acme-v02.api.letsencrypt.org/directory

# The operator's contact address, registered with the authority. It receives expiry warnings and
# account notices, so an address somebody reads — not a customer's, and not a no-reply.
Acme__ContactEmail=

# Where the agent keeps certificate material: root-owned, outside every account's home, because a
# site's PHP runs as that customer and must not be able to read the key that serves it.
Acme__CertificateStorePath=/var/lib/maran/certs
