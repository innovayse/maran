# Shape of /etc/maran/panel.env — the production configuration file.
#
# This file is NOT copied to a server. The installer GENERATES panel.env during step 60-config,
# with a freshly generated encryption key, and writes it root:panel 0640 so only root and the
# panel service can read it. It is kept here so an operator can see what the installer produces
# and what may safely be edited by hand afterwards.
#
# Anything in this file is a secret or a machine-specific value. Non-secret defaults belong in
# backend/src/Maran.Host/appsettings.json, which ships with the product.

# Base64-encoded 256-bit key encrypting secrets at rest. Generated per installation.
# NEVER copy a key between servers, and never rotate it by hand: rotating without re-encrypting
# makes every stored secret unreadable. The panel refuses to start without a valid key.
Security__EncryptionKey=

# Base64 key the panel's access tokens are signed with. Generated per installation and preserved
# across re-runs: it is not used to encrypt anything, so rotating it destroys no data — but every
# issued token stops verifying at once, which signs every operator out mid-upgrade.
Jwt__SigningKey=

# Panel database, one key per part rather than a single connection string: an operator changing a
# database name or role edits one line without re-quoting a blob. Production connects over the
# local unix socket — Host is the socket DIRECTORY, no port and no password are involved, and
# PostgreSQL authenticates the panel by its operating-system user (peer authentication).
Database__Host=/var/run/postgresql
Database__Database=maran
Database__Username=panel

# Port and password are intentionally absent above, not forgotten:
#   - Port applies only to a TCP host. When Database__Host is a directory (a unix socket), the
#     panel omits the port entirely; setting one would make it attempt a TCP connection instead.
#   - Password is empty because the socket connection is authenticated by the operating-system
#     user (peer authentication) — there is no password to store, rotate or leak.
# Uncomment BOTH only if you deliberately move the database to another host, which also means
# exposing PostgreSQL on the network — a decision to make consciously, not by editing one line:
# Database__Port=5432
# Database__Password=

# One-time token that authorizes creating the first administrator in the browser. The installer
# prints the setup link on the terminal only — deliberately not in the install log. The token
# stops working once the first administrator exists.
Setup__Token=

# Address the api listens on. It binds loopback only; nginx terminates TLS on 8443 and proxies
# here, so this port is never reachable from outside the machine. Change it together with the
# proxy_pass in the nginx vhost — the two must always agree.
ASPNETCORE_URLS=http://127.0.0.1:5080

# ACME (Let's Encrypt and compatible authorities), used when a certificate is issued for a site.
#
# PRODUCTION here, unlike development, which defaults to staging: a server issues certificates that
# browsers must actually trust. Point this at the staging directory only to test a server's own
# issuance path, and expect untrusted certificates while it is set.
Acme__DirectoryUrl=https://acme-v02.api.letsencrypt.org/directory

# The operator's contact address, registered with the authority. It receives expiry warnings and
# account notices, so an address somebody reads — not a customer's, and not a no-reply.
Acme__ContactEmail=

# Where the agent keeps certificate material: root-owned, outside every account's home, because a
# site's PHP runs as that customer and must not be able to read the key that serves it.
Acme__CertificateStorePath=/var/lib/maran/certs
