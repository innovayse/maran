# /etc/maran/agent.env — read by installer/systemd/maran-agent.service.
#
# Generated by the installer (installer/lib/60-config.sh) once the `panel` user exists. It holds
# no secret, so it is world-readable, unlike panel.env. This file documents it; the installer
# never reads this example.

# The single uid the agent accepts connections from, checked against SO_PEERCRED before any
# request reaches a handler. In production it is the uid of the `panel` user that maran-api runs
# as, which is why it cannot be a fixed number here: useradd assigns it at install time.
#
# It is not optional, and the two ways of getting it wrong fail differently. Left EMPTY, systemd
# drops the argument, the agent falls back to its own uid — root — and denies the API every
# request. Set to something that is not a number, the agent REFUSES TO START: an access rule
# nobody chose is worse than a service that says so. Both are the failure this file exists to
# prevent.
MARAN_AGENT_ALLOW_UID=997

# The free-space floor, in MiB (issue #148). While less than this is available to an
# unprivileged writer on the filesystem an operation writes into, the agent refuses to create
# an account, take or restore a backup, or accept an upload there, and the panel reports the
# refusal as "AgentBelowFreeSpaceFloor". The panel's disk alert fires when the root filesystem
# has less than twice this left, before the refusals begin. A whole number from 1; zero or
# anything else makes the agent refuse to start. The installer keeps an existing value on a
# re-run and writes 1024 otherwise.
MARAN_AGENT_FREE_SPACE_FLOOR_MIB=1024
