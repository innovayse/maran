# Rendered by Maran. Do not edit: this file is replaced whenever the site changes.
<VirtualHost *:80>
    ServerName {{ domain }}
{% for alias in aliases %}    ServerAlias {{ alias }}
{% endfor %}
    CustomLog {{ access_log }} combined
    ErrorLog {{ error_log }}

    # A suspended account's certificate still renews on schedule, so the ACME HTTP-01
    # challenge must stay reachable even though everything else on the site answers with
    # the fixed refusal below.
    Alias /.well-known/acme-challenge/ {{ document_root }}/.well-known/acme-challenge/
    <Directory {{ document_root }}/.well-known/acme-challenge/>
        # A link is followed only when it and its target share an owner
        # (see SiteBody).
        Options -Indexes -FollowSymLinks +SymLinksIfOwnerMatch
        AllowOverride None
        ForceType text/plain
        Require all granted
    </Directory>

    # A suspended account keeps its vhost, so the domain still resolves to a clear answer
    # instead of a connection refusal, but serves nothing of the account's own.
    ErrorDocument 403 "This site has been suspended."
    <LocationMatch "^(?!/\.well-known/acme-challenge/)">
        Require all denied
    </LocationMatch>
</VirtualHost>
{#
  This comment exists to give the file a SECOND trailing newline, so the render ends with
  one. askama drops exactly one newline at the end of a template; without this the render
  ended `</VirtualHost>` with no newline.

  What that costs is not cosmetic. `ops::sites::is_suspended_vhost` decides whether a site
  is suspended by rendering this template and comparing the file BYTE FOR BYTE; a file that
  gains a trailing newline from anything at all stops matching, the site reads as not
  suspended, and the next certificate renewal puts the suspended customer's site back on
  the air.
#}
