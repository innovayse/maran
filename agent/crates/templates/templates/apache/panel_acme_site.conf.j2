# Rendered by Maran. Do not edit: this file is replaced whenever the panel's host name changes.
# The panel's ONE plain-HTTP virtual host while Apache owns port 80, and it serves exactly one
# thing: the ACME HTTP-01 challenge for the panel's own host name. The panel's interface stays
# on its own port behind nginx; everything but the challenge directory is 404.
<VirtualHost *:80>
    ServerName {{ server_name }}

    Alias /.well-known/acme-challenge/ {{ challenge_directory }}/
    <Directory {{ challenge_directory }}/>
        Options -Indexes -FollowSymLinks
        AllowOverride None
        ForceType text/plain
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ - [R=404,L]

    # The path without its query string, so a secret in a URL never reaches the log.
    LogFormat "%h %l %u %t \"%m %U %H\" %>s %b" maran_no_query
    CustomLog {{ access_log }} maran_no_query
    ErrorLog {{ error_log }}
</VirtualHost>

