# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
#
# The whole Dovecot 2.3 configuration, in one file with no includes: the
# packaged conf.d files are not read, so none of their settings can override
# these. Written whole, never appended to.
#
# Mailboxes are virtual. Each line of the users file names the account's uid and
# gid and the mailbox's own home, and Dovecot serves and delivers under that uid.
protocols = imap{% if pop3_enabled %} pop3{% endif %} lmtp
disable_plaintext_auth = yes
auth_mechanisms = plain login
auth_verbose = no
auth_verbose_passwords = no
auth_debug = no
mail_debug = no
verbose_ssl = no

# Account uids start at 1000 on every supported family; a lower one is a system
# account and is never served.
first_valid_uid = 1000
mail_location = maildir:~/Maildir

ssl = required
ssl_cert = <{{ certificate_path }}
ssl_key = <{{ private_key_path }}
ssl_min_protocol = TLSv1.2
ssl_prefer_server_ciphers = yes

passdb {
  driver = passwd-file
  args = username_format=%u {{ users_path }}
}

userdb {
  driver = passwd-file
  args = username_format=%u {{ users_path }}
}

service auth {
  unix_listener {{ sasl_socket }} {
    mode = 0660
    user = {{ postfix_user }}
    group = {{ postfix_user }}
  }
}

service lmtp {
  unix_listener {{ lmtp_socket }} {
    mode = 0600
    user = {{ postfix_user }}
    group = {{ postfix_user }}
  }
}
{# A trailing comment keeps the final newline, which askama would otherwise drop. #}
