# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
#
# The whole Dovecot 2.4 configuration, in one file with no includes. The 2.4
# generation is not read by 2.3 and does not read 2.3's, which is why there are
# two renders. Written whole, never appended to.
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0
protocols = imap{% if pop3_enabled %} pop3{% endif %} lmtp
auth_allow_cleartext = no
auth_mechanisms = plain login
auth_username_format = %{user}
auth_verbose = no
auth_debug = no
mail_debug = no
verbose_ssl = no

# Account uids start at 1000 on every supported family; a lower one is a system
# account and is never served.
first_valid_uid = 1000
mail_driver = maildir
mail_path = ~/Maildir

ssl = required
ssl_server_cert_file = {{ certificate_path }}
ssl_server_key_file = {{ private_key_path }}
ssl_min_protocol = TLSv1.2
ssl_prefer_server_ciphers = yes

passdb passwd-file {
  passwd_file_path = {{ users_path }}
}

userdb passwd-file {
  passwd_file_path = {{ users_path }}
}

service auth {
  unix_listener {{ sasl_socket }} {
    mode = 0660
    user = {{ postfix_user }}
    group = {{ postfix_user }}
  }
}

service lmtp {
  unix_listener {{ lmtp_socket }} {
    mode = 0600
    user = {{ postfix_user }}
    group = {{ postfix_user }}
  }
}
{# A trailing comment keeps the final newline, which askama would otherwise drop. #}
