# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
#
# Settings of the Lua rule (lua.local.d/maran_local_submit.lua) that binds mail an
# account submits locally to that account's own sender domains and to its hourly
# send limit. The five maps are written by the mail data plane; a missing or
# unreadable one makes the rule defer the mail instead of letting it through.
enabled = true;
accounts_map = "{{ maps_directory }}/local_submit_accounts.map";
sender_domains_map = "{{ maps_directory }}/account_sender_domains.map";
send_limits_map = "{{ maps_directory }}/account_send_limits.map";
mailbox_accounts_map = "{{ maps_directory }}/mailbox_accounts.map";
# Every alias and catch-all of the account and how many deliveries outside the server
# each makes (0 for one that stays inside): a message to such an alias costs the hourly
# bucket one unit per delivery, at least one, because Postfix expands the alias after
# the rule has counted the recipient once. An address listed here is an alias, so it
# never falls through to the domain's catch-all.
alias_fanout_map = "{{ maps_directory }}/alias_fanout.map";
# The name under which the rule leaves, on the message, the proof that its From:
# domain is bound to the submitting account. The DKIM condition reads the same name.
bound_domain_key = "{{ self.bound_domain_key() }}";
# Recipients one locally submitted message may name: smtpd_recipient_limit does not
# apply to the pickup road, so the rule enforces it.
max_recipients = {{ max_recipients }};
# Exactly root and the Postfix owner, rendered by the agent and never derived from
# anything a customer controls.
exempt_uids = [{% for uid in exempt_uids %}{{ uid }}{% if !loop.last %}, {% endif %}{% endfor %}];
# The host's own mail name: the only From: domain whose mail from those users is proven for DKIM
# signing. A tenant's domain is never proven on the strength of a trusted uid.
host_mail_name = "{{ host_mail_name }}";
{# A trailing comment keeps the final newline, which askama would otherwise drop. #}
