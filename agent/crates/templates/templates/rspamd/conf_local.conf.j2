# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
#
# Rspamd reads the settings of a module it does not know only from a section of this
# file, never from local.d/<name>.conf on its own. This section configures the
# local-submission rule (plugins.d/maran_local_submit.lua, loaded as a module by its
# file name) from the settings file the agent renders beside it.
maran_local_submit {
  .include "$LOCAL_CONFDIR/local.d/maran_local_submit.conf"
}
{# A trailing comment keeps the final newline, which askama would otherwise drop. #}
