# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
#
# The scores at which a message is greylisted, marked as spam, or rejected.
# They rise in that order; the panel validates it and so does the agent.
greylist = {{ greylist }};
add_header = {{ add_header }};
reject = {{ reject }};
{# A trailing comment keeps the final newline, which askama would otherwise drop. #}
