# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
#
# Every service runs unchrooted (chroot column "n"): the sockets to Dovecot and
# Rspamd are absolute paths outside the queue directory, and the two families
# ship different defaults for that column. Written whole, never appended to.
#
# Local submission (issue #518, docs/mail/local-submission.md): the road is told by
# the daemon name the milter is given, which is a fact of the SERVICE and not of the
# message. Only `pickup` (sendmail, postdrop, PHP mail()) uses `cleanup_local`, so
# only mail that came that way is MARAN_LOCAL. Port 25 reports INBOUND and the two
# login services ORIGINATING, so a customer connecting to any of them can never be
# taken for a local submission.
#
# The same service runs the table that names the submitting uid in a header: Postfix
# shows a milter no Received line of its own, and that line is where the uid is
# (issue #591, docs/mail/local-submission.md).
#
# Port 25 also refuses a client connecting from this host itself (issue #531): the
# table names the loopback and every interface address, and a customer's process
# reaching port 25 from the server would otherwise arrive as outside mail,
# counted against no account. Any other client is permitted here and still meets
# the relay and recipient restrictions of main.cf. The table sits after the
# `check_client_access` word as the next list element, the form master.cf can
# carry because it splits an `-o` value at whitespace. `smtpd_delay_reject=no` makes the
# refusal the greeting itself: by default Postfix greets first and refuses at RCPT.
#
# service  type  private unpriv  chroot  wakeup  maxproc command + args
smtp       inet  n       -       n       -       -       smtpd
  -o smtpd_client_restrictions=check_client_access,cidr:{{ self_clients_path }},permit
  -o smtpd_delay_reject=no
  -o milter_macro_daemon_name=INBOUND
submission inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=reject_non_fqdn_recipient,permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
smtps      inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=reject_non_fqdn_recipient,permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
pickup     unix  n       -       n       60      1       pickup
  -o cleanup_service_name=cleanup_local
cleanup    unix  n       -       n       -       0       cleanup
cleanup_local unix n     -       n       -       0       cleanup
  -o milter_macro_daemon_name=MARAN_LOCAL
  -o header_checks=regexp:{{ local_submitter_headers_path }}
qmgr       unix  n       -       n       300     1       qmgr
tlsmgr     unix  -       -       n       1000?   1       tlsmgr
rewrite    unix  -       -       n       -       -       trivial-rewrite
bounce     unix  -       -       n       -       0       bounce
defer      unix  -       -       n       -       0       bounce
trace      unix  -       -       n       -       0       bounce
verify     unix  -       -       n       -       1       verify
flush      unix  n       -       n       1000?   0       flush
proxymap   unix  -       -       n       -       -       proxymap
proxywrite unix  -       -       n       -       1       proxymap
smtp       unix  -       -       n       -       -       smtp
relay      unix  -       -       n       -       -       smtp
showq      unix  n       -       n       -       -       showq
error      unix  -       -       n       -       -       error
retry      unix  -       -       n       -       -       error
discard    unix  -       -       n       -       -       discard
lmtp       unix  -       -       n       -       -       lmtp
anvil      unix  -       -       n       -       1       anvil
scache     unix  -       -       n       -       1       scache
{# A trailing comment keeps the final newline, which askama would otherwise drop. #}
