# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
#
# This file is written WHOLE, every time, through the safe-write protocol, and
# never appended to: Postfix takes the LAST occurrence of a parameter, so an
# appended line does not sit inert below the rendered one, it replaces it.
#
# Virtual hosting only. Nothing is delivered to a system account (mydestination
# is empty and local delivery is an error); every mailbox is a virtual one
# served by Dovecot over the LMTP socket below, under its account's own uid.
compatibility_level = 2
# Pinned, not left to the package default: pickup writes it into the Received line
# the cleanup_local header_checks table matches ("by <host> (Postfix, from userid N)",
# issues #518 and #591).
mail_name = Postfix
myhostname = {{ hostname }}
myorigin = $myhostname
mydestination =
# No network is trusted by address. Empty on purpose and written explicitly: left
# unset, Postfix derives it from the host's interfaces, and loopback in it would
# let any process of any customer relay without a login (issue #458).
mynetworks =
inet_interfaces = all
inet_protocols = all
relayhost =
alias_maps =
alias_database =
local_recipient_maps =
local_transport = error:local delivery is disabled
recipient_delimiter = +
biff = no
smtpd_banner = $myhostname ESMTP
disable_vrfy_command = yes

# Ceilings. The message size is a bound on one message, in bytes.
message_size_limit = {{ message_size_bytes }}
mailbox_size_limit = 0
smtpd_recipient_limit = {{ recipient_limit }}
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60

# The lookup tables. Rendered by the agent from the panel's database; the type
# is a fact of the host because the Berkeley DB backend is not on
# every supported release.
virtual_mailbox_domains = {{ map_type }}:{{ virtual_domains_path }}
virtual_mailbox_maps = {{ map_type }}:{{ virtual_mailboxes_path }}
virtual_alias_maps = {{ map_type }}:{{ virtual_aliases_path }}
# Postfix expands an alias AFTER the filter counted the recipient once, so the
# expansion is bounded here and the filter charges an alias its external targets
# (alias_fanout.map, issue #531). Beyond the bound Postfix defers the message.
virtual_alias_expansion_limit = {{ alias_expansion_limit }}
smtpd_sender_login_maps = {{ map_type }}:{{ sender_login_maps_path }}
virtual_transport = lmtp:unix:{{ lmtp_socket }}

# TLS. The key is listed before the chain, as smtpd_tls_chain_files requires.
# Protocols are an exclusion list because that spelling is understood by every
# Postfix release the product supports; the newer ">=TLSv1.2" form is not.
smtpd_tls_chain_files = {{ private_key_path }}, {{ certificate_path }}
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_security_level = may
smtp_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1

# Authentication is switched on per service in master.cf, never globally.
smtpd_sasl_type = dovecot
smtpd_sasl_path = {{ sasl_socket }}
smtpd_sasl_auth_enable = no

# Relaying. These are the restrictions of the port 25 service, which takes no
# login: it accepts mail for a domain served here and refuses everything else,
# whoever the peer is and whatever address it connects from. Relaying needs a
# login, and only the submission services (master.cf) take one and apply the
# sender-to-login check. No restriction here names a network or a login.
smtpd_helo_required = yes
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unauth_destination

# Local submission. `sendmail` and `postdrop` (PHP's mail() runs the first) put
# a message in the maildrop queue and `pickup` delivers it, and no smtpd
# restriction sits on that road: no login, no sender-to-login check, no send
# limit. So the road is closed to everybody but the users the table names: root,
# the Postfix owner, and the system user of each account whose mail is enabled
# (written by the mail data plane). An empty table admits nobody else, and a
# user missing from it is refused by postdrop itself (issue #500). The table is
# read by the submitting user's own uid, so it sits in this directory and not
# under /etc/maran.
authorized_submit_users = root, $mail_owner, {{ map_type }}:{{ local_submit_users_path }}

# Spam filtering and DKIM signing. An unreachable filter defers the mail rather
# than letting it through unsigned and unchecked.
smtpd_milters = unix:{{ milter_socket }}
# Mail Postfix's own daemons generate (bounces, notices) does not pass
# non_smtpd_milters while internal_mail_filter_classes is empty, which is its
# default; it is left unset on purpose, so the local-submission rule sees only
# mail that came in through postdrop (#518).
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = tempfail
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
{# The line above must be followed by a newline: a trailing comment keeps it, because askama drops one trailing newline from a template. #}
