# Rendered by the Maran agent. Hand edits are overwritten on the next apply.
# The replace idiom: create-if-absent, delete, redeclare — nft -f is ADDITIVE
# without it, and an apply that merely appended left a removed rule live.
table inet maran {}
delete table inet maran

table inet maran {
    chain input {
        type filter hook input priority 0; policy drop;

        # Loopback first: the panel's own nginx→Kestrel hop lives here and
        # nothing — not even a ban — may sever it. Bans hook at priority -5
        # in table inet maran_bans and repeat this exemption for the same
        # reason.
        iif "lo" accept

        ct state invalid drop
        ct state established,related accept

        ip protocol icmp accept
        # 58 is ICMPv6, written as the NUMBER because the name is not one nft
        # knows: it resolves `ipv6-icmp` through getprotobyname, i.e. through
        # /etc/protocols, which is a file a minimal host can be missing. Then
        # the whole ruleset fails to load with "Could not resolve protocol
        # name" and the host is left with no firewall at all — measured on a
        # base image without it. `ip protocol icmp` above is a different case
        # and is left as the name: nft resolves that one itself, verified on
        # the same host with no /etc/protocols.
        meta l4proto 58 accept

{% for ssh in ssh_ports %}{% if ssh.rules.is_empty() %}        tcp dport {{ ssh.port }} accept
{% else %}{% for rule in ssh.rules %}{% if let Some(network) = rule.source.network() %}        tcp dport {{ ssh.port }} {{ network.family_keyword }} saddr {{ network.cidr }} accept
{% else %}        tcp dport {{ ssh.port }} accept
{% endif %}{% endfor %}{% endif %}{% endfor %}        tcp dport {{ panel_port }} accept
{% for allow in allows %}{% if let Some(network) = allow.source.network() %}        {{ allow.protocol }} dport {{ allow.port }}{% if let Some(upper) = allow.port_to %}-{{ upper }}{% endif %} {{ network.family_keyword }} saddr {{ network.cidr }} accept
{% else %}        {{ allow.protocol }} dport {{ allow.port }}{% if let Some(upper) = allow.port_to %}-{{ upper }}{% endif %} accept
{% endif %}{% endfor %}    }

    # Every address this host answers on, loopback included: the destination
    # test of the output chain below. Two sets because an nft set holds one
    # address family. The loopback network is written here as a constant and
    # the host's own addresses follow it; the caller never passes a loopback
    # address, which would overlap the interval and fail the whole load.
    set self_v4 {
        type ipv4_addr
        flags interval
        elements = { 127.0.0.0/8{% for prefix in self_v4_prefixes %}, {{ prefix.0 }}/{{ prefix.1 }}{% endfor %}{% for address in self_v4 %}, {{ address }}{% endfor %} }
    }

    set self_v6 {
        type ipv6_addr
        elements = { ::1{% for address in self_v6 %}, {{ address }}{% endfor %} }
    }

    # Defence in depth for the mail stack's port-25 lockdown (#531): a
    # customer-range uid may not open an SMTP connection to this host itself,
    # because that path reaches the public smtpd without authentication and
    # without the per-domain sending bound. The uid RANGE is the test and not
    # a group: an account's group includes the web server. The mail stack's
    # own users, root and every other system uid are below the floor and
    # unaffected; so is every other port, and every other destination.
    chain output {
        type filter hook output priority 0; policy accept;

        meta skuid >= {{ customer_uid_min }} ip daddr @self_v4 tcp dport 25 reject with tcp reset
        meta skuid >= {{ customer_uid_min }} ip6 daddr @self_v6 tcp dport 25 reject with tcp reset
    }
}

