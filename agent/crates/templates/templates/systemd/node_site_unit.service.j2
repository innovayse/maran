# Rendered by Maran. Do not edit: this file is replaced whenever the site changes.
[Unit]
Description=Maran Node.js {{ node_major }} application for {{ domain }}
After=network.target

[Service]
Type=simple
# The account's own uid and its primary group: the application runs with exactly the
# rights the account has over its files, and with no others.
User={{ account }}
WorkingDirectory={{ document_root }}
Environment=NODE_ENV=production
Environment=PORT={{ port }}
ExecStart={{ executable }}{% for argument in arguments %} {{ argument }}{% endfor %}
Restart=on-failure
RestartSec=2

# The same sandbox reasoning as the other units the agent runs for tenants: the application
# may write inside its account's home and nowhere else on the file system, can never gain
# privileges, and reaches the network only over IP and its own unix sockets.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths={{ home_directory }}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target

