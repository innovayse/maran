# Rendered by Maran. Do not edit: this file is replaced whenever the account's
# SFTP access changes.
[Unit]
Description=Maran SFTP jail home for {{ account }}

[Mount]
# The account's real home, mounted into its root-owned jail rather than copied
# into it: the home keeps its own ownership and mode, so nginx, php-fpm and
# every site path go on reading exactly the directory they read before.
What={{ source_directory }}
Where={{ mount_point }}
Type=none
Options=bind
# A bind mount follows the INODE, so when the account's home is replaced (a
# whole-account restore renames a new tree into place) the jail must be mounted
# again. A session still inside the jail keeps the old mount busy, and a plain
# unmount of a busy mount fails and leaves the jail showing the old tree;
# detaching it lazily lets the restart succeed while the session ends on its own.
LazyUnmount=yes

[Install]
WantedBy=multi-user.target

